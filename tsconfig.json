{
  // moduleResolution "bundler" is the deliberate choice here: both scripts that run this repo
  // (tsx for server/, esbuild inside Vite for browser/) resolve modules the bundler way, not the
  // stricter NodeNext way (which would demand explicit file extensions on relative imports that
  // neither runner actually needs). "bundler" matches what really executes the code.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  // `on-ground/` is GONE as of kaafil-js@0.1.0-beta.3: the SDK's browser entry
  // now wires all sixteen on-ground resource groups, so both halves — the Node
  // walkthrough and the browser page — call `kaafil-js`/`kaafil-js/client`
  // directly and there is no third, hand-rolled client left to type-check.
  "include": [
    "server/**/*.ts",
    "browser/**/*.ts",
    "browser/**/*.tsx",
    "backend/**/*.ts"
  ]
}
