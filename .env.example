# Engine base URL — point this at your Kaafil engine (local or self-hosted).
# A local engine serves port 3000.
KAAFIL_BASE_URL=http://localhost:3000

# Partner API key (kf_test_... or kf_live_...) — collected once from the Kaafil partner console.
KAAFIL_API_KEY=kf_test_your_key_here

# Your agency's external id, used for trip ingest and reading its triggers.
KAAFIL_AGENCY_REF=your-agency-ref

# NOTE: these three are read by the SERVER halves only (server/simulate.ts and
# backend/server.ts). The browser half takes its base URL and token pair from
# the page's own inputs, because a browser bundle must never be built with
# credentials baked into it.
#
# The browser half also needs a setting on the ENGINE, not here: CORS_ORIGIN must
# allowlist the origin serving the page (http://localhost:5173 for `pnpm dev`).
# The engine denies all cross-origin browser callers by default, and a blocked
# request surfaces as a transport error with no status — see the README.

# Port backend/server.ts listens on.
PORT=4000

# The origin backend/server.ts's CORS allows (its Access-Control-Allow-Origin).
# Must match wherever `pnpm dev` (vite browser) is actually serving the
# playground from — 5173 is vite's own default and this repo's fixed port.
PLAYGROUND_ORIGIN=http://localhost:5173

# Optional. Only needed by step 44 (the receipt upload), and only against an
# engine that signs its presigned upload URLs for a hostname THIS process
# cannot resolve — the common case being a docker-compose engine whose
# S3_ENDPOINT is MinIO's internal hostname ("minio"), reachable from inside
# the compose network but not from this repo's own host process. Set this to
# the host:port docker-compose ALSO publishes that storage on for the host
# machine (this repo's own kaafil-engine compose file: "localhost:19000").
# Leave unset against a real deployment — a real storage endpoint is
# reachable by definition, and this variable does nothing there. See the
# README's "the presigned upload and this repo's own docker network" section.
# KAAFIL_STORAGE_LOCAL_PROXY=localhost:19000
