{"nodes": [{"id": "claude_md_document", "label": "CLAUDE.md Working Brief", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_r1_api_key_boundary", "label": "R1: API key read only in backend/server.ts", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A partner API key baked into a browser bundle is a key anyone opening devtools now holds; no browser file may import it, receive it as a prop, or accept it from a query string."}, {"id": "claude_md_r2_sdk_entry_separation", "label": "R2: SDK entry points stay separate at module-graph level", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kaafil-js/client must have no code path that imports the API-key branch even by accident; enforced structurally, not by convention."}, {"id": "claude_md_r3_simulated_mode", "label": "R3: Simulated mode needs nothing running", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every screen must be backed by browser/src/logic/sim/; a change that makes any Simulated screen require a network call is wrong \u2014 this is the repo's best feature."}, {"id": "claude_md_r4_badge_system", "label": "R4: Three-badge system (sdk/plan/console)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_r5_error_reserialization", "label": "R5: Errors re-serialised faithfully", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Connected-mode failure and a Simulated one must read identically in the response panel \u2014 that symmetry is what makes Simulated mode trustworthy."}, {"id": "claude_md_r6_direct_manager_lane", "label": "R6: Manager lane goes direct tab-to-engine", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is the real shape of a manager's device; do not interpose a proxy a real deployment would not have."}, {"id": "claude_md_r7_pinned_version", "label": "R7: kaafil-js pinned exact version", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A floating ^0.1.0-beta.x range is how this repo would silently break on a beta bump; only move to caret once kaafil-js cuts a stable release."}, {"id": "claude_md_r8_pinned_toolchain", "label": "R8: packageManager and .nvmrc pinned", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73 R8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_raw_badge_removal", "label": "The 'raw' badge is gone", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "kaafil-js@0.1.0-beta.3 wired all sixteen resource groups into the browser entry, so no operation this playground drives is unreachable by the SDK any more; a dead badge in a legend reads as a live one."}, {"id": "claude_md_gaps_upkeep_obligation", "label": "GAPS.md upkeep obligation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A register that lists a shipped capability as missing is worse than no register, because it is read as current."}, {"id": "claude_md_design_generation", "label": "browser/.design/ is generated output", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_md_gates", "label": "Repo gates: typecheck, test, build, simulate", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_md_r4_badge_system", "target": "gaps_badge_taxonomy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73 R4", "weight": 1.0}, {"source": "claude_md_raw_badge_removal", "target": "gaps_raw_badge_history", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "claude_md_r7_pinned_version", "target": "gaps_dist_tag_wrinkle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73 R7", "weight": 1.0}, {"source": "claude_md_gaps_upkeep_obligation", "target": "gaps_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a76", "weight": 1.0}, {"source": "claude_md_r3_simulated_mode", "target": "readme_simulated_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "claude_md_r2_sdk_entry_separation", "target": "gaps_onground_write_unreachable", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": "\u00a73 R2", "weight": 0.85}, {"source": "claude_md_r5_error_reserialization", "target": "readme_error_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73 R5", "weight": 1.0}, {"source": "claude_md_gates", "target": "readme_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "claude_md_r1_api_key_boundary", "target": "backend_readme_api_key_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73 R1", "weight": 1.0}, {"source": "claude_md_r6_direct_manager_lane", "target": "readme_connected_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "\u00a73 R6", "weight": 1.0}], "hyperedges": [{"id": "shared_badge_taxonomy", "label": "Three-badge taxonomy (sdk/plan/console) shared across CLAUDE.md, README.md, GAPS.md", "nodes": ["claude_md_r4_badge_system", "readme_badge_reading", "gaps_badge_taxonomy"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md"}, {"id": "api_key_server_only_boundary", "label": "API-key-stays-server-side boundary enforced across rule, implementation, and docs", "nodes": ["claude_md_r1_api_key_boundary", "backend_readme_api_key_isolation", "readme_backend_routes"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md"}]}